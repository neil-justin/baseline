# Supabase (ADR 0003) — copy to .env.local and fill with your project's values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...           # publishable/anon key (browser + SSR identity)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...                   # service-role key — server-only, bypasses RLS
SUPABASE_DB_PASSWORD=your-database-password               # direct pg connections (psql / migrations)

# ── Seed identities (scripts/seed-accounts.mjs) ────────────────────────────
# Privacy rule: real addresses NEVER enter the repo — env vars only.
# Neil (demo student, canon seed) = your real account email.
SEED_NEIL_EMAIL=you@gmail.com
# System Admin = the same human, plus-addressed (a distinct auth identity, same inbox).
SEED_SYSADMIN_EMAIL=you+sys-admin@gmail.com
# Org-like demo cohort domain (marco@…, …, adviser@…). Defaults to campus.test when unset.
SEED_COHORT_DOMAIN=campus.test
# All seeded accounts share the demo password (default: readiness).
#SEED_PASSWORD=readiness

# ── E2E (npx playwright test) ──────────────────────────────────────────────
# The specs sign in as Neil (canon walk). Must match the seeded Neil account.
E2E_NEIL_EMAIL=you@gmail.com
E2E_NEIL_PASSWORD=readiness

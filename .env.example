# Supabase (ADR 0003) — copy to .env.local and fill with your project's values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...           # publishable/anon key (browser + SSR identity)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...                   # service-role key — server-only, bypasses RLS
SUPABASE_DB_PASSWORD=your-database-password               # direct pg connections (psql / migrations)
